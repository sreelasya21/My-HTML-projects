<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lasya - Portfolio</title>
    <!-- Bootstrap CSS -->
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
    <!-- Tailwind CSS -->
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>

<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-light bg-light">
        <a class="navbar-brand head" href="#">Portfolio</a>
        <div class="collapse navbar-collapse">
            <ul class="navbar-nav ml-auto">
                <li class="nav-item"><a class="nav-link" href="#about">About</a></li>
                <li class="nav-item"><a class="nav-link" href="#projects">Projects</a></li>
                <li class="nav-item"><a class="nav-link" href="#contact">Contact</a></li>
            </ul>
        </div>
    </nav>

    <!-- About Section -->
    <section id="about" class="p-5 bg-gray-100">
        <div class="container">
            <h1 class="text-center head">About Me</h1>
            <p class="text-center">Hi, I'm Lasya, a dedicated computer science student with a growing passion for creating intuitive, user-friendly digital experiences. As I work towards my degree, I’m building skills in web development, HTML, CSS, C and gaining hands-on experience with tools like JavaScript, Python and Bootstrap.In my free time, you can find me playing ping-pong, exploring linkedin, reading books.</p>
        </div>
    </section>

    <!-- Projects Section -->
    <section id="projects" class="p-5">
        <div class="container">
            <h2 class=" head text-center">Projects</h2>
            <div class="row">
                <!-- Repeat this card for each project -->
                <div class="col-md-4">
                    <div class="card">
                        <img src="data:image/jpeg;base64," class="card-img-top" alt="Project">
                        <div class="card-body">
                            <h5 class="card-title">Tara Watches</h5>
                            <p class="card-text">A website similar to titan showcasing watches.</p>
                            <a href="https://tarawatches.ccbp.tech/" class="ref">View Website</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card">
                        <img src="data:image/jpeg;base64," class="card-img-top" alt="Project">
                        <div class="card-body">
                            <h5 class="card-title">Corsell courses</h5>
                            <p class="card-text">An online course providing platform similar to simplilearn.</p>
                            <a href="https://corsell.ccbp.tech/" class="ref">View Website</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card">
                        <img src="data:image/jpeg;base64," class="card-img-top" alt="Project">
                        <div class="card-body">
                            <h5 class="card-title">Musicx</h5>
                            <p class="card-text">A music website similar to spotify to listen songs.</p>
                            <a href="https://musicx.ccbp.tech/" class="ref">View Website</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Contact Section (Form) -->
    <section id="contact" class="p-5 bg-gray-100">
        <div class="container">
            <h2 class="text-center">Contact Me</h2>
            <form id="contact-form">
                <div class="form-group">
                    <label for="name">Name</label>
                    <input type="text" class="form-control" id="name" name="name" required>
                </div>
                <div class="form-group">
                    <label for="email">Email</label>
                    <input type="email" class="form-control" id="email" name="email" required>
                </div>
                <div class="form-group">
                    <label for="message">Message</label>
                    <textarea class="form-control" id="message" name="message" rows="3" required></textarea>
                </div>
                <button type="submit" class="btn btn-primary">Send Message</button>
            </form>
        </div>
    </section>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.bundle.min.js"></script>
</body>

</html>

